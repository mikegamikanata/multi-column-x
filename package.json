{
  "name": "multi-column-x",
  "private": true,
  "version": "0.8.6",
  "type": "module",
  "scripts": {
    "build:inject": "vite build --config vite.inject.config.ts && vite build --config vite.inject.config.ts --mode react",
    "dev": "npm run build:inject && vite",
    "build": "npm run build:inject && tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "format": "npm run format:ts && npm run format:rust && npm run format:kotlin",
    "format:ts": "prettier --write .",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:kotlin": "cd src-tauri\\gen\\android && .\\gradlew.bat ktlintFormat",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "tauri": "tauri",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:property": "vitest run --project unit property.test",
    "test:story": "vitest run --project storybook",
    "tauri:dev": "npm run build:inject && tauri dev",
    "tauri:build": "npm run build:inject && tauri build",
    "tauri:build:debug": "tauri build --debug",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build",
    "tauri:android:build:debug": "tauri android build --debug",
    "tauri:android:dev:clear-cache": "tauri android dev -- --clear-cache",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "docs:screenshots": "storybook build && node scripts/docs-screenshots/capture.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-log": "^2.10.2",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.5.1",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "i18next": "^27.1.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@eslint/js": "^9.39.5",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-mcp": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tauri-apps/cli": "^2.12.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "^5.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-storybook": "^10.6.7",
    "fast-check": "^4.10.3",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "sass-embedded": "^1.108.2",
    "storybook": "^10.6.7",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-svgr": "^5.2.0",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.1"
  }
}
